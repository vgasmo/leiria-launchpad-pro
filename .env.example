# ============================================
# Lovable Cloud Environment Configuration
# ============================================
# These variables are auto-configured by Lovable Cloud.
# DO NOT commit actual values to version control.

# Supabase Configuration (required - auto-populated by Lovable Cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional: Override app URL (defaults to window.location.origin)
# VITE_APP_URL=https://your-custom-domain.com

# ============================================
# Edge Function Secrets
# ============================================
# These are set in Lovable Cloud > Backend > Secrets
# DO NOT add these to .env - they are server-side only

# CRON_SECRET - Authentication for scheduled cron jobs
# WEBHOOK_SECRET - Authentication for external webhooks
# RESEND_API_KEY - Email notifications via Resend
# LOVABLE_API_KEY - AI features (auto-configured)

# Optional integrations (set in Lovable Cloud if needed):
# MS_GRAPH_CLIENT_ID - Microsoft Graph App ID
# MS_GRAPH_CLIENT_SECRET - Microsoft Graph API (Outlook/Teams)
# MS_GRAPH_TENANT_ID - Microsoft tenant
# APP_URL - Used by edge functions for building links

# Signature Providers (set in Lovable Cloud > Backend > Secrets):
# PANDADOC_API_KEY - PandaDoc API key for document creation/sending
# PANDADOC_WEBHOOK_KEY - Shared secret for PandaDoc webhook verification
# WEBHOOK_SECRET is also used for DocuSign webhook verification
